{
  "model": {
    "hf_repo": "unsloth/Qwen3.6-27B-MTP-GGUF",
    "hf_tokenizer": "Qwen/Qwen3.6-27B",
    "quant_exclude_pattern": "F16|F32|MTP|Q8"
  },

  "llama_server": {
    "binary": "/data/tensor2/llama.cpp/build/bin/llama-server",
    "port": 8050,
    "host": "0.0.0.0",
    "context_size": 32768,
    "flash_attn": true,
    "split_mode": "tensor",
    "batch_size": 1024,
    "ubatch_size": 1024,
    "cache_type_k": "q4_0",
    "cache_type_v": "q4_0",
    "n_parallel": 3,
    "sampling": {
      "temp": 0.6,
      "top_p": 0.95,
      "top_k": 20,
      "min_p": 0.0
    },
    "chat_template_kwargs": { "enable_thinking": false },
    "mtp": {
      "enabled": true,
      "spec_type": "draft-mtp",
      "spec_draft_n_max": 3,
      "spec_draft_p_min": 0.0
    },
    "extra_args": ["-lv","4"]
  },

  "benchmark": {
    "download_dir": ".",
    "startup_wait_seconds": 10,
    "keep_downloads": true
  },

  "inspect": {
    "working_dir": "/data/benches/scripts/inspect_evals",
    "done_marker_dir": "/data/benches/scripts",
    "base_url": "http://localhost:8050/v1/",
    "api_key": "sk1",
    "sample_shuffle": 42,
    "seed": 42,
    "max_retries": 5,
    "tasks": {
      "bbeh_mini": {
        "enabled": false,
        "limit": 100,
        "max_sandboxes": 1,
        "max_connections": 1,
        "time_limit": 600
      },
      "bigcodebench": {
        "enabled": false,
        "limit": 0,
        "max_sandboxes": 4,
        "max_connections": 4,
        "time_limit": 300,
	"task_args": {
	   "score_display": true
	}
      },
      "musr": {
        "enabled": true,
        "limit": 0,
        "max_sandboxes": 1,
        "max_connections": 1,
        "time_limit": 300
      },
      "bfcl": {
        "enabled": true,
        "limit": 1000,
        "max_sandboxes": 1,
        "max_connections": 1,
        "time_limit": 300
      },
      "tau2_telecom": {
        "enabled": false,
        "limit": 0,
        "max_sandboxes": 2,
        "max_connections": 2,
        "time_limit": 300
      },
      "swe_bench": {
        "enabled": false,
        "limit": 100,
        "max_sandboxes": 1,
        "max_connections": 1,
        "time_limit": 600
      }
    }
  }
}
